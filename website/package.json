{
  "name": "jiahao-toolbox-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "refresh-release": "node scripts/refresh-release.mjs",
    "build": "npm run refresh-release && npm run build:offline",
    "build:offline": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test:unit": "node --test tests/release.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "typescript": "6.0.3",
    "@playwright/test": "1.64.1"
  }
}
